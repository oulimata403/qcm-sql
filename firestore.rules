
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Vérifie que le compte connecté est l'administrateur autorisé.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "oulimatat17@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Vérifie que l'utilisateur accède à son propre profil.
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    // Profils des utilisateurs
    match /users/{userId} {

      // Un utilisateur lit son profil.
      // L'administrateur peut lire tous les profils.
      allow read: if isOwner(userId) || isAdmin();

      // Chaque utilisateur peut créer et modifier uniquement son profil.
      allow create, update: if isOwner(userId);

      // Personne ne peut supprimer un profil.
      allow delete: if false;
    }

    // Collection admins : aucun accès nécessaire avec cette méthode.
    // L'administration est vérifiée à partir de l'adresse e-mail.
    match /admins/{adminId} {
      allow read, write: if false;
    }
  }
}
