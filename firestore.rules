rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "oulimatat17@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Seuls ces champs sont autorisés dans un profil
    function validProfile(userId) {
      return request.resource.data.keys().hasOnly([
        'uid', 'firstName', 'lastName', 'fullName', 'email',
        'progress', 'totalQuizzes', 'createdAt', 'lastLoginAt',
        'lastProgressUpdate'
      ])
      && request.resource.data.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId) && validProfile(userId);

      // On interdit de modifier la date d'inscription
      allow update: if isOwner(userId)
        && validProfile(userId)
        && request.resource.data.get('createdAt', null)
           == resource.data.get('createdAt', null);

      allow delete: if false;
    }

    // Signalements d'erreurs : tout utilisateur connecté peut en créer,
    // seul l'administrateur peut les lire, les modifier ou les supprimer.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'userName', 'type', 'itemId',
          'title', 'details', 'comment', 'page', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.userEmail is string
        && request.resource.data.userName is string
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 40
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() <= 100
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 3
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 300;

      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
